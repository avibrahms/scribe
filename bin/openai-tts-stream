#!/usr/bin/env python3
"""
Stream OpenAI text-to-speech (gpt-4o-mini-tts) with low latency and a reliable
stop, designed as a drop-in sibling of `edge-tts-stream`.

It shares the SAME pid file and the SAME audio player (sox `play`) as
edge-tts-stream so Scribe's existing three-path stop logic silences it too.

No third-party packages: the OpenAI Audio Speech REST endpoint is called with
the standard library (urllib + ssl), and the streamed MP3 body is piped
straight into `play -t mp3 -`.

The API key is read from $OPENAI_API_KEY, or from
~/.config/speak-selection/openai_key (0600). It is never written to the repo.
"""
import json
import os
import re
import signal
import subprocess
import sys
import time
import urllib.request
import urllib.error

CONFIG_DIR = os.path.expanduser("~/.config/speak-selection")
SETTINGS_FILE = os.path.join(CONFIG_DIR, "settings.json")
CONFIG_FILE = os.path.join(CONFIG_DIR, "config")
KEY_FILE = os.path.join(CONFIG_DIR, "openai_key")
# Same pid file as edge-tts-stream: only one playback runs at a time, and this
# lets `edge-tts-stream --stop` (and Scribe's stop) kill us by process group.
PID_FILE = os.path.join(CONFIG_DIR, "speak.pid")

PLAYER_CMD = ["/opt/homebrew/bin/play", "-t", "mp3", "-q", "-"]

API_URL = "https://api.openai.com/v1/audio/speech"
DEFAULT_MODEL = "gpt-4o-mini-tts"
DEFAULT_VOICE = "coral"
DEFAULT_INSTRUCTIONS = (
    "Perform this text aloud like an expressive human storyteller — never a "
    "narrator droning through a script. Constantly vary your pitch, pace, and "
    "volume: rise with excitement, slow down and lower your voice for emphasis "
    "or suspense, lift the ends of questions, and let energy build and release "
    "across sentences. Use clear emotional ups and downs that match the meaning "
    "of the words — warmth, curiosity, surprise, enthusiasm. Add natural human "
    "rhythm with small pauses for breath and thought. Absolutely avoid a flat, "
    "monotone, robotic, or detached delivery; every sentence should sound alive "
    "and genuinely felt."
)
# The speech endpoint caps input at 4096 chars. Stay well under, and make the
# first chunk small so audio starts quickly, then use larger chunks.
FIRST_CHUNK_CHARS = 700
MAX_CHUNK_CHARS = 3200


def stop_existing():
    """Kill any currently running speech process group. SIGTERM first,
    escalate to SIGKILL if the group survives."""
    try:
        with open(PID_FILE) as f:
            pgid = int(f.read().strip())
    except (OSError, ValueError):
        return
    if pgid != os.getpgrp():
        try:
            os.killpg(pgid, signal.SIGTERM)
        except (ProcessLookupError, PermissionError):
            pass
        else:
            for _ in range(10):
                time.sleep(0.05)
                try:
                    os.killpg(pgid, 0)
                except (ProcessLookupError, PermissionError):
                    break
            else:
                try:
                    os.killpg(pgid, signal.SIGKILL)
                except (ProcessLookupError, PermissionError):
                    pass
    try:
        os.unlink(PID_FILE)
    except OSError:
        pass


def parse_args():
    args = {"stop": False, "text": None, "stdin": False,
            "voice": None, "instructions": None, "model": None, "speed": None}
    i = 1
    while i < len(sys.argv):
        a = sys.argv[i]
        if a == "--stop":
            args["stop"] = True
        elif a == "--stdin":
            args["stdin"] = True
        elif a == "--text" and i + 1 < len(sys.argv):
            i += 1
            args["text"] = sys.argv[i]
        elif a.startswith("--text="):
            args["text"] = a[7:]
        elif a == "--voice" and i + 1 < len(sys.argv):
            i += 1
            args["voice"] = sys.argv[i]
        elif a.startswith("--voice="):
            args["voice"] = a[8:]
        elif a == "--instructions" and i + 1 < len(sys.argv):
            i += 1
            args["instructions"] = sys.argv[i]
        elif a.startswith("--instructions="):
            args["instructions"] = a[len("--instructions="):]
        elif a == "--model" and i + 1 < len(sys.argv):
            i += 1
            args["model"] = sys.argv[i]
        elif a.startswith("--model="):
            args["model"] = a[8:]
        elif a == "--speed" and i + 1 < len(sys.argv):
            i += 1
            args["speed"] = sys.argv[i]
        elif a.startswith("--speed="):
            args["speed"] = a[8:]
        i += 1
    return args


# Shared language detector, deployed next to this script. Optional on
# purpose: if it is missing we simply speak with the configured voice, which
# is what this helper did before per-language voices existed.
try:
    import tts_lang
except Exception:
    tts_lang = None

# Shared fallbacks, deployed alongside. Optional too: without it a failure is
# reported instead of handed on to the free Edge voice.
try:
    import tts_fallback
except Exception:
    tts_fallback = None

# The free sibling that takes over when OpenAI can't speak (no key, no
# credits, no network). It falls back further, to the Mac's voice, by itself.
EDGE_HELPER = os.path.join(
    os.path.dirname(os.path.abspath(__file__)), "edge-tts-stream")


def auto_voice(text, settings, explicit):
    """Voice to speak `text` with: an explicit --voice always wins.

    Mirrors scribe_core.resolve_tts_voice so the ⌃D Quick Action and the app
    menu pick the same voice for the same text.
    """
    if explicit:
        return explicit
    default = settings["openai_voice"]
    if tts_lang is None or not settings.get("tts_autodetect", True):
        return default
    try:
        lang = tts_lang.detect_language(text)
        return tts_lang.voice_for_lang(
            settings.get("openai_voice_by_lang"), lang, default,
            settings.get("openai_lang_defaults"))
    except Exception:
        return default


def load_settings():
    settings = {
        "openai_voice": DEFAULT_VOICE,
        "openai_instructions": DEFAULT_INSTRUCTIONS,
        "openai_model": DEFAULT_MODEL,
        "openai_speed": 1.0,
        "openai_voice_by_lang": {},
        "openai_lang_defaults": {},
        "tts_autodetect": True,
    }
    if os.path.exists(SETTINGS_FILE):
        try:
            with open(SETTINGS_FILE) as f:
                data = json.load(f)
            for k in settings:
                if data.get(k):
                    settings[k] = data[k]
            # Read separately: the truthiness test above would silently drop
            # a stored `false`, leaving auto-detect stuck on.
            if isinstance(data.get("tts_autodetect"), bool):
                settings["tts_autodetect"] = data["tts_autodetect"]
        except Exception:
            pass
    return settings


def load_api_key():
    key = (os.environ.get("OPENAI_API_KEY") or "").strip()
    if key:
        return key
    try:
        with open(KEY_FILE) as f:
            return f.read().strip()
    except OSError:
        return ""


# --- Text cleaning for speech (mirrors edge-tts-stream) -------------------

_RE_MD_IMAGE = re.compile(r'!\[([^\]]*)\]\([^)]+\)')
_RE_MD_LINK = re.compile(r'\[([^\]]*)\]\([^)]+\)')
_RE_HTML_TAG = re.compile(r'<[^>]+>')
_RE_CODE_FENCE = re.compile(r'```[a-zA-Z]*')
_RE_HEADING = re.compile(r'(?m)^#{1,6}\s+')
_RE_BLOCKQUOTE = re.compile(r'(?m)^>\s*')
_RE_BULLET = re.compile(r'(?m)^[\-\*]\s+')
_RE_NUMBERED = re.compile(r'(?m)^\d+\.\s+')
_RE_BOLD_ITALIC = re.compile(
    r'(?<!\w)[_*]{1,3}(?!\w)|(?<!\w)[_*]{1,3}(?=\w)|(?<=\w)[_*]{1,3}(?!\w)')
_RE_INLINE_CODE = re.compile(r'`([^`]+)`')
_RE_HR = re.compile(r'(?m)^[\-\*_]{3,}\s*$')
_RE_URL = re.compile(r'https?://([^\s\)\]]+)')
_RE_NOISE = re.compile(r'[|~\\]')
_RE_EMOJI = re.compile(
    r'[\U0001F600-\U0001F64F'
    r'\U0001F300-\U0001F5FF'
    r'\U0001F680-\U0001F6FF'
    r'\U0001F1E0-\U0001F1FF'
    r'\U0001F900-\U0001F9FF'
    r'\U0001FA00-\U0001FA6F'
    r'\U0001FA70-\U0001FAFF'
    r'\U00002702-\U000027B0'
    r'\U0000FE00-\U0000FE0F'
    r'\U0000200D'
    r'\U000020E3'
    r'\U00002600-\U000026FF'
    r'\U00002300-\U000023FF'
    r'\U00002B50-\U00002B55'
    r'\U0000203C-\U00003299'
    r']+', re.UNICODE
)
_RE_MULTI_SPACE = re.compile(r'[ \t]{2,}')
_RE_MULTI_NEWLINE = re.compile(r'\n{3,}')


def _humanize_url(match):
    url = match.group(1).rstrip('.,;:!?')
    url = re.sub(r'^www\.', '', url)
    parts = url.split('/', 1)
    domain = parts[0].replace('.', ' dot ')
    if len(parts) > 1 and parts[1]:
        path = parts[1].strip('/')
        path = path.replace('_', ' ').replace('-', ' ').replace('/', ', ')
        path = re.sub(r'\.([a-zA-Z]{2,4})$', r' dot \1', path)
        path = re.sub(r'[?#].*', '', path)
        if path.strip():
            return f"{domain}, {path}"
    return domain


def clean_text_for_speech(text):
    text = _RE_EMOJI.sub('', text)
    text = _RE_MD_IMAGE.sub(r'\1', text)
    text = _RE_MD_LINK.sub(r'\1', text)
    text = _RE_HTML_TAG.sub('', text)
    text = _RE_CODE_FENCE.sub('', text)
    text = _RE_HR.sub('', text)
    text = _RE_HEADING.sub('', text)
    text = _RE_BLOCKQUOTE.sub('', text)
    text = _RE_BULLET.sub('', text)
    text = _RE_NUMBERED.sub('', text)
    text = _RE_INLINE_CODE.sub(r'\1', text)
    text = _RE_BOLD_ITALIC.sub('', text)
    text = _RE_URL.sub(_humanize_url, text)
    text = re.sub(r'(?<=\w)_(?=\w)', ' ', text)
    text = _RE_NOISE.sub('', text)
    text = re.sub(r'(?<!\w)#(?!\w)', '', text)
    text = _RE_MULTI_SPACE.sub(' ', text)
    text = _RE_MULTI_NEWLINE.sub('\n\n', text)
    return text.strip()


_RE_SENTENCE = re.compile(r'(.+?(?:[.!?。！？\n]+|$))', re.S)


def chunk_text(text):
    """Split into <=MAX_CHUNK_CHARS pieces at sentence boundaries. The first
    piece is kept small so the first audio arrives quickly."""
    sentences = [s for s in _RE_SENTENCE.findall(text) if s.strip()]
    chunks = []
    buf = ""
    limit = FIRST_CHUNK_CHARS
    for s in sentences:
        # A single oversized sentence: flush, then hard-split it.
        if len(s) > limit and not buf:
            for j in range(0, len(s), limit):
                chunks.append(s[j:j + limit])
            limit = MAX_CHUNK_CHARS
            continue
        if len(buf) + len(s) > limit:
            if buf:
                chunks.append(buf)
            buf = s
            limit = MAX_CHUNK_CHARS
        else:
            buf += s
    if buf.strip():
        chunks.append(buf)
    return [c.strip() for c in chunks if c.strip()]


def api_error_message(body):
    """The human-readable message inside an OpenAI error body, else the body."""
    try:
        return str(json.loads(body)["error"]["message"])
    except Exception:
        return body.strip()


def stream_tts(text, voice, instructions, model, speed, api_key):
    """Stream OpenAI TTS audio for each chunk into one continuous player.

    Returns (reason, unread): why synthesis stopped and the text not yet
    spoken, or (None, "") when it all played or a Stop cut it short.
    """
    chunks = chunk_text(text)
    played = 0  # chunks that reached the player in full
    reason = None
    player = None
    try:
        for chunk in chunks:
            body = {
                "model": model,
                "voice": voice,
                "input": chunk,
                "response_format": "mp3",
                "speed": speed,
            }
            # Only gpt-4o-* models accept `instructions`; tts-1 / tts-1-hd
            # reject it. Send it solely where it does something.
            if instructions and model.startswith("gpt-4o"):
                body["instructions"] = instructions
            payload = json.dumps(body).encode("utf-8")
            req = urllib.request.Request(
                API_URL,
                data=payload,
                headers={
                    "Authorization": f"Bearer {api_key}",
                    "Content-Type": "application/json",
                },
                method="POST",
            )
            try:
                with urllib.request.urlopen(req, timeout=60) as resp:
                    while True:
                        block = resp.read(8192)
                        if not block:
                            break
                        if player is None:
                            # Started on the first audio, so a refused
                            # request never leaves an empty player printing
                            # half a line into our stderr.
                            player = subprocess.Popen(
                                PLAYER_CMD, stdin=subprocess.PIPE)
                        player.stdin.write(block)
                        player.stdin.flush()
            except urllib.error.HTTPError as e:
                detail = ""
                try:
                    detail = api_error_message(e.read().decode("utf-8", "replace"))
                except Exception:
                    pass
                detail = " ".join(detail.split())[:300]
                reason = f"HTTP {e.code}: {detail}"
                break
            except urllib.error.URLError as e:
                reason = f"network error: {e.reason}"
                break
            played += 1
        if reason is None and player is not None:
            player.stdin.close()
            if player.wait() > 0:
                reason = f"The audio player failed (exit {player.returncode})."
    except BrokenPipeError:
        # Killed by a signal = a Stop, which takes us down with it anyway.
        if player.wait() > 0:
            reason = "The audio player quit unexpectedly."
    except Exception as exc:
        reason = str(exc) or type(exc).__name__
    finally:
        if player is not None:
            try:
                if player.stdin and not player.stdin.closed:
                    player.stdin.close()
            except Exception:
                pass
            if player.poll() is None:
                player.kill()
                player.wait()
    if reason is None:
        return None, ""
    return reason, "\n\n".join(chunks[played:])


def hand_off_to_edge(text, reason):
    """Read the text with the free Edge helper instead.

    Replaces this process (same pid and process group, so a Stop still
    reaches it) and returns only when Edge can't be started.
    """
    if tts_fallback is None or not os.access(EDGE_HELPER, os.X_OK):
        return
    tts_fallback.notify("Read aloud: using Microsoft Edge",
                        f"OpenAI failed: {reason}")
    try:
        tts_fallback.exec_with_stdin([EDGE_HELPER, "--stdin"], text)
    except OSError:
        pass


def main():
    """Exit status: 1 when nothing could read the text (reason on stderr),
    else 0."""
    args = parse_args()

    if args["stop"]:
        stop_existing()
        return

    stop_existing()

    try:
        os.setpgrp()
    except OSError:
        pass

    os.makedirs(CONFIG_DIR, exist_ok=True)
    with open(PID_FILE, "w") as f:
        f.write(str(os.getpgid(0)))

    try:
        if args["stdin"]:
            args["text"] = sys.stdin.read()
        if not args["text"]:
            return

        api_key = load_api_key()
        if not api_key:
            reason = f"no API key (set OPENAI_API_KEY or {KEY_FILE})"
            print(f"[openai-tts] {reason}", file=sys.stderr)
            hand_off_to_edge(args["text"], reason)
            return 1

        settings = load_settings()
        voice = auto_voice(args["text"], settings, args["voice"])
        instructions = args["instructions"] or settings["openai_instructions"]
        model = args["model"] or settings["openai_model"]
        try:
            speed = float(args["speed"] if args["speed"] is not None
                          else settings["openai_speed"])
        except (TypeError, ValueError):
            speed = 1.0
        speed = min(4.0, max(0.25, speed))

        text = clean_text_for_speech(args["text"])
        if not text:
            return

        try:
            reason, unread = stream_tts(
                text, voice, instructions, model, speed, api_key)
        except (KeyboardInterrupt, SystemExit):
            return
        if reason is None:
            return
        # Scribe and speak-selection.sh show this line to the user when
        # nothing else speaks either, so a failure is never silent.
        print(f"[openai-tts] {reason}", file=sys.stderr)
        hand_off_to_edge(unread, reason)
        return 1
    finally:
        try:
            with open(PID_FILE) as f:
                if int(f.read().strip()) == os.getpgid(0):
                    os.unlink(PID_FILE)
        except (OSError, ValueError):
            pass


if __name__ == "__main__":
    sys.exit(main())
