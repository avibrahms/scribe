#!/usr/bin/env python3
"""
Stream Speechify text-to-speech (simba-3.5) with low latency and a reliable
stop, designed as a drop-in sibling of `edge-tts-stream`.

It shares the SAME pid file and the SAME audio player (sox `play`) as
edge-tts-stream so Scribe's existing three-path stop logic silences it too.

No third-party packages: Speechify's streaming REST endpoint is called with
the standard library (urllib + ssl), and the streamed MP3 body is piped
straight into `play -t mp3 -`.

The API key is read from $SPEECHIFY_API_KEY, or from
~/.config/speak-selection/speechify_key (0600). It is never written to the
repo.
"""
import json
import os
import re
import subprocess
import sys
import time
import urllib.request
import urllib.error
from xml.sax.saxutils import escape

# Shared with edge-tts-stream, deployed alongside: only one read runs at a
# time, and `edge-tts-stream --stop` (and Scribe's stop) kills ours too.
from tts_proc import CONFIG_DIR, claim, release, stop_existing

SETTINGS_FILE = os.path.join(CONFIG_DIR, "settings.json")
KEY_FILE = os.path.join(CONFIG_DIR, "speechify_key")

PLAYER_CMD = ["/opt/homebrew/bin/play", "-t", "mp3", "-q", "-"]

API_URL = "https://api.speechify.ai/v1/audio/stream"
MODEL = "simba-3.5"
DEFAULT_VOICE = "harper_32"
# Speed is sent as an SSML prosody rate, which starts at -50%.
SPEED_MIN, SPEED_MAX = 0.5, 4.0
# The locale sent as `language` when the text is not in the voice's own
# language (a voice reading its own language needs none).
LANG_LOCALES = {"en": "en-US", "fr": "fr-FR", "es": "es-ES",
                "de": "de-DE", "it": "it-IT"}
# The stream endpoint takes far more per request. Stay small anyway: a small
# first chunk so audio starts quickly, then larger ones.
FIRST_CHUNK_CHARS = 700
MAX_CHUNK_CHARS = 3200
# A refused request is retried when Speechify says it came too fast (the free
# plan allows one a second), so a long read keeps its voice.
RATE_LIMIT_RETRIES = 2
RATE_LIMIT_MAX_WAIT = 10.0


def parse_args():
    args = {"stop": False, "text": None, "stdin": False,
            "voice": None, "speed": None}
    i = 1
    while i < len(sys.argv):
        a = sys.argv[i]
        if a == "--stop":
            args["stop"] = True
        elif a == "--stdin":
            args["stdin"] = True
        elif a == "--text" and i + 1 < len(sys.argv):
            i += 1
            args["text"] = sys.argv[i]
        elif a.startswith("--text="):
            args["text"] = a[7:]
        elif a == "--voice" and i + 1 < len(sys.argv):
            i += 1
            args["voice"] = sys.argv[i]
        elif a.startswith("--voice="):
            args["voice"] = a[8:]
        elif a == "--speed" and i + 1 < len(sys.argv):
            i += 1
            args["speed"] = sys.argv[i]
        elif a.startswith("--speed="):
            args["speed"] = a[8:]
        i += 1
    return args


# Shared language detector, deployed next to this script. Optional on
# purpose: if it is missing we simply speak with the configured voice, which
# is what this helper did before per-language voices existed.
try:
    import tts_lang
except Exception:
    tts_lang = None

# Shared fallbacks, deployed alongside. Optional too: without it a failure is
# reported instead of handed on to the free Edge voice.
try:
    import tts_fallback
except Exception:
    tts_fallback = None

# Shared text preparation (markdown, tables, symbols, units), deployed
# alongside. Optional too: without it the text is read as written.
try:
    import tts_text
except Exception:
    tts_text = None

# The free sibling that takes over when Speechify can't speak (no key, the
# month's free characters used up, no network). It falls back further, to the Mac's voice, by itself.
EDGE_HELPER = os.path.join(
    os.path.dirname(os.path.abspath(__file__)), "edge-tts-stream")


def detect_lang(text, settings):
    """Language code of `text`, or None when unsure or auto-detect is off."""
    if tts_lang is None or not settings.get("tts_autodetect", True):
        return None
    try:
        return tts_lang.detect_language(text)
    except Exception:
        return None


def auto_voice(lang, settings, explicit):
    """Voice to speak text of language `lang` with: an explicit --voice always
    wins.

    Mirrors scribe_core.resolve_tts_voice so the ⌃D Quick Action and the app
    menu pick the same voice for the same text.
    """
    if explicit:
        return explicit
    default = settings["speechify_voice"]
    if tts_lang is None or not lang:
        return default
    try:
        return tts_lang.voice_for_lang(
            settings.get("speechify_voice_by_lang"), lang, default,
            settings.get("speechify_lang_defaults"))
    except Exception:
        return default


def request_language(lang, voice, settings):
    """The `language` to send, or None when the voice reads its own language
    (or the language of the text is unknown)."""
    if not lang:
        return None
    voice_langs = settings.get("speechify_voice_langs")
    own = voice_langs.get(voice) if isinstance(voice_langs, dict) else None
    if own == lang:
        return None
    return LANG_LOCALES.get(lang)


def load_settings():
    settings = {
        "speechify_voice": DEFAULT_VOICE,
        "speechify_speed": 1.0,
        "speechify_voice_by_lang": {},
        "speechify_lang_defaults": {},
        "speechify_voice_langs": {},
        "tts_autodetect": True,
    }
    if os.path.exists(SETTINGS_FILE):
        try:
            with open(SETTINGS_FILE) as f:
                data = json.load(f)
            for k in settings:
                if data.get(k):
                    settings[k] = data[k]
            # Read separately: the truthiness test above would silently drop
            # a stored `false`, leaving auto-detect stuck on.
            if isinstance(data.get("tts_autodetect"), bool):
                settings["tts_autodetect"] = data["tts_autodetect"]
        except Exception:
            pass
    return settings


def load_api_key():
    key = (os.environ.get("SPEECHIFY_API_KEY") or "").strip()
    if key:
        return key
    try:
        with open(KEY_FILE) as f:
            return f.read().strip()
    except OSError:
        return ""


_RE_SENTENCE = re.compile(r'(.+?(?:[.!?。！？\n]+|$))', re.S)


def chunk_text(text):
    """Split into <=MAX_CHUNK_CHARS pieces at sentence boundaries. The first
    piece is kept small so the first audio arrives quickly."""
    sentences = [s for s in _RE_SENTENCE.findall(text) if s.strip()]
    chunks = []
    buf = ""
    limit = FIRST_CHUNK_CHARS
    for s in sentences:
        # A single oversized sentence: flush, then hard-split it.
        if len(s) > limit and not buf:
            for j in range(0, len(s), limit):
                chunks.append(s[j:j + limit])
            limit = MAX_CHUNK_CHARS
            continue
        if len(buf) + len(s) > limit:
            if buf:
                chunks.append(buf)
            buf = s
            limit = MAX_CHUNK_CHARS
        else:
            buf += s
    if buf.strip():
        chunks.append(buf)
    return [c.strip() for c in chunks if c.strip()]


def api_error_message(body):
    """The human-readable message inside a Speechify error body, else the body."""
    try:
        return str(json.loads(body)["error"]["message"])
    except Exception:
        return body.strip()


def to_ssml(chunk, speed):
    """`chunk` as SSML, at `speed` times the normal rate.

    Always SSML, never plain text: Speechify decides by itself whether an
    input is SSML, so a plain "<" or "&" must not be left for it to guess at.
    """
    body = escape(chunk, {'"': "&quot;", "'": "&apos;"})
    percent = round((speed - 1.0) * 100)
    if percent:
        body = f'<prosody rate="{percent:+d}%">{body}</prosody>'
    return f"<speak>{body}</speak>"


def build_request(chunk, voice, speed, language, api_key):
    body = {
        "model": MODEL,
        "voice_id": voice,
        "input": to_ssml(chunk, speed),
        # Numbers and dates spoken as words.
        "options": {"text_normalization": True},
    }
    if language:
        body["language"] = language
    return urllib.request.Request(
        API_URL,
        data=json.dumps(body).encode("utf-8"),
        headers={
            "Authorization": f"Bearer {api_key}",
            "Content-Type": "application/json",
            "Accept": "audio/mpeg",
            "User-Agent": "scribe-read-aloud",
        },
        method="POST",
    )


def retry_after(error):
    """Seconds Speechify asks to wait before the next request."""
    try:
        wait = float(error.headers.get("Retry-After") or 1.0)
    except (TypeError, ValueError):
        wait = 1.0
    return min(RATE_LIMIT_MAX_WAIT, max(0.5, wait))


def stream_tts(text, voice, speed, language, api_key):
    """Stream Speechify audio for each chunk into one continuous player.

    Returns (reason, unread): why synthesis stopped and the text not yet
    spoken, or (None, "") when it all played or a Stop cut it short.
    """
    chunks = chunk_text(text)
    played = 0  # chunks that reached the player in full
    reason = None
    player = None
    try:
        for chunk in chunks:
            req = build_request(chunk, voice, speed, language, api_key)
            retries = RATE_LIMIT_RETRIES
            while True:
                reason = None
                try:
                    with urllib.request.urlopen(req, timeout=60) as resp:
                        while True:
                            block = resp.read(8192)
                            if not block:
                                break
                            if player is None:
                                # Started on the first audio, so a refused
                                # request never leaves an empty player
                                # printing half a line into our stderr.
                                player = subprocess.Popen(
                                    PLAYER_CMD, stdin=subprocess.PIPE)
                            player.stdin.write(block)
                            player.stdin.flush()
                except urllib.error.HTTPError as e:
                    if e.code == 429 and retries > 0:
                        retries -= 1
                        time.sleep(retry_after(e))
                        continue
                    detail = ""
                    try:
                        detail = api_error_message(
                            e.read().decode("utf-8", "replace"))
                    except Exception:
                        pass
                    detail = " ".join(detail.split())[:300]
                    reason = f"HTTP {e.code}: {detail}"
                except urllib.error.URLError as e:
                    reason = f"network error: {e.reason}"
                break
            if reason is not None:
                break
            played += 1
        if reason is None and player is not None:
            player.stdin.close()
            if player.wait() > 0:
                reason = f"The audio player failed (exit {player.returncode})."
    except BrokenPipeError:
        # Killed by a signal = a Stop, which takes us down with it anyway.
        if player.wait() > 0:
            reason = "The audio player quit unexpectedly."
    except Exception as exc:
        reason = str(exc) or type(exc).__name__
    finally:
        if player is not None:
            try:
                if player.stdin and not player.stdin.closed:
                    player.stdin.close()
            except Exception:
                pass
            if player.poll() is None:
                player.kill()
                player.wait()
    if reason is None:
        return None, ""
    return reason, "\n\n".join(chunks[played:])


def hand_off_to_edge(text, reason):
    """Read the text with the free Edge helper instead.

    Replaces this process (same pid and process group, so a Stop still
    reaches it) and returns only when Edge can't be started.
    """
    if tts_fallback is None or not os.access(EDGE_HELPER, os.X_OK):
        return
    tts_fallback.notify("Read aloud: using Microsoft Edge",
                        f"Speechify failed: {reason}")
    try:
        tts_fallback.exec_with_stdin([EDGE_HELPER, "--stdin"], text)
    except OSError:
        pass


def main():
    """Exit status: 1 when nothing could read the text (reason on stderr),
    else 0."""
    args = parse_args()

    if args["stop"]:
        stop_existing()
        return

    stop_existing()
    claim()

    try:
        if args["stdin"]:
            args["text"] = sys.stdin.read()
        if not args["text"]:
            return

        api_key = load_api_key()
        if not api_key:
            reason = f"no API key (set SPEECHIFY_API_KEY or {KEY_FILE})"
            print(f"[speechify-tts] {reason}", file=sys.stderr)
            hand_off_to_edge(args["text"], reason)
            return 1

        settings = load_settings()
        lang = detect_lang(args["text"], settings)
        voice = auto_voice(lang, settings, args["voice"])
        language = request_language(lang, voice, settings)
        try:
            speed = float(args["speed"] if args["speed"] is not None
                          else settings["speechify_speed"])
        except (TypeError, ValueError):
            speed = 1.0
        speed = min(SPEED_MAX, max(SPEED_MIN, speed))

        text = (tts_text.clean_text_for_speech(
                    args["text"], tts_text.speech_lang(args["text"], None))
                if tts_text is not None else args["text"].strip())
        if not text:
            return

        try:
            reason, unread = stream_tts(
                text, voice, speed, language, api_key)
        except (KeyboardInterrupt, SystemExit):
            return
        if reason is None:
            return
        # Scribe and speak-selection.sh show this line to the user when
        # nothing else speaks either, so a failure is never silent.
        print(f"[speechify-tts] {reason}", file=sys.stderr)
        hand_off_to_edge(unread, reason)
        return 1
    finally:
        release()


if __name__ == "__main__":
    sys.exit(main())
