#!/Users/avi/.local/pipx/venvs/edge-tts/bin/python
"""
Stream edge-tts audio with minimal latency and reliable stop.

Uses process groups and a PID file for clean stop from any source.
"""
import json
import os
import re
import signal
import subprocess
import sys
import threading
import time

# Shared with speechify-tts-stream, deployed alongside: only one read runs at a
# time, whichever helper started it.
from tts_proc import CONFIG_DIR, claim, release, stop_existing

if __name__ == "__main__" and "--stop" in sys.argv[1:]:
    # Before anything else is loaded: a Stop should cost as little as it can.
    stop_existing()
    sys.exit(0)

SETTINGS_FILE = os.path.join(CONFIG_DIR, "settings.json")

PLAYER_CMD = ["/opt/homebrew/bin/play", "-t", "mp3", "-q", "-"]


def parse_args():
    """Fast arg parsing without argparse."""
    args = {"stop": False, "standby": False, "text": None, "stdin": False,
            "voice": None, "rate": None, "pitch": None, "volume": None}
    i = 1
    while i < len(sys.argv):
        a = sys.argv[i]
        if a == "--stop":
            args["stop"] = True
        elif a == "--standby":
            args["standby"] = True
        elif a == "--stdin":
            args["stdin"] = True
        elif a == "--text" and i + 1 < len(sys.argv):
            i += 1
            args["text"] = sys.argv[i]
        elif a.startswith("--text="):
            args["text"] = a[7:]
        elif a == "--voice" and i + 1 < len(sys.argv):
            i += 1
            args["voice"] = sys.argv[i]
        elif a.startswith("--voice="):
            args["voice"] = a[8:]
        elif a == "--rate" and i + 1 < len(sys.argv):
            i += 1
            args["rate"] = sys.argv[i]
        elif a.startswith("--rate="):
            args["rate"] = a[7:]
        elif a == "--pitch" and i + 1 < len(sys.argv):
            i += 1
            args["pitch"] = sys.argv[i]
        elif a.startswith("--pitch="):
            args["pitch"] = a[8:]
        elif a == "--volume" and i + 1 < len(sys.argv):
            i += 1
            args["volume"] = sys.argv[i]
        elif a.startswith("--volume="):
            args["volume"] = a[9:]
        i += 1
    return args


# Shared helpers deployed next to this script, loaded by load_tools() once a
# read needs them. Each is optional on purpose:
#   tts_lang      language detector; without it the configured voice speaks,
#                 which is what this helper did before per-language voices;
#   tts_fallback  the Mac's own voice and notifications; without it a failure
#                 is reported instead of worked around;
#   tts_text      text preparation (markdown, tables, symbols, units); without
#                 it the text is read as written.
tts_lang = tts_fallback = tts_text = None


def load_tools():
    global tts_lang, tts_fallback, tts_text
    try:
        import tts_lang
    except Exception:
        tts_lang = None
    try:
        import tts_fallback
    except Exception:
        tts_fallback = None
    try:
        import tts_text
    except Exception:
        tts_text = None


def auto_voice(text, settings, explicit):
    """Voice to speak `text` with: an explicit --voice always wins.

    Mirrors scribe_core.resolve_tts_voice so the ⌃D Quick Action and the app
    menu pick the same voice for the same text.
    """
    if explicit:
        return explicit
    default = settings["voice"]
    if tts_lang is None or not settings.get("tts_autodetect", True):
        return default
    try:
        lang = tts_lang.detect_language(text)
        return tts_lang.voice_for_lang(
            settings.get("edge_voice_by_lang"), lang, default,
            settings.get("edge_lang_defaults"))
    except Exception:
        return default


def load_settings():
    """Voice, rate, pitch and volume as Scribe last saved them."""
    settings = {"voice": "en-US-BrianNeural", "rate": "+0%",
                "pitch": "+0Hz", "volume": "+0%",
                "edge_voice_by_lang": {}, "edge_lang_defaults": {},
                "tts_autodetect": True}
    try:
        with open(SETTINGS_FILE) as f:
            settings.update(json.load(f))
    except Exception:
        pass
    return settings


# Read aloud must not hinge on any one thing Microsoft controls. In order:
#   1. every synthesis endpoint, starting with the last one that worked;
#   2. if they all refuse (or edge-tts is missing), a freshly upgraded
#      edge-tts. Microsoft changes what it accepts every few months (October
#      2026: a new Sec-MS-GEC token), upstream usually ships the fix within a
#      day or two, and nothing else would ever install it here;
#   3. the Mac's own voice (tts_fallback), which needs no network at all.

# Every host Microsoft has served the read-aloud voices from, as templates on
# the library's public client token. The installed library's own URL is tried
# too, so a host a future edge-tts moves to needs no edit here.
EDGE_ENDPOINTS = (
    "wss://speech.platform.bing.com/consumer/speech/synthesize/readaloud"
    "/edge/v1?TrustedClientToken={token}",
    "wss://api.msedgeservices.com/tts/cognitiveservices/websocket/v1"
    "?Ocp-Apim-Subscription-Key={token}",
)
LAST_ENDPOINT_FILE = os.path.join(CONFIG_DIR, "edge-endpoint")
# Per endpoint: a host that hangs must not hold up the next one.
CONNECT_TIMEOUT = 5

# A refusal upgrades edge-tts at most once an hour, so an outage costs one pip
# check an hour rather than one per read.
UPGRADE_STAMP = os.path.join(CONFIG_DIR, "edge-tts-upgrade.stamp")
UPGRADE_INTERVAL = 3600
# Longest a read with no voice yet waits for the upgrade (it usually takes a
# few seconds). Past that the Mac's voice reads it, and pip finishes alone.
UPGRADE_WAIT = 30


# Silence written into the player between table rows (tts_text.BREAK): no
# punctuation makes Edge pause longer than a full stop, which is also what
# separates the pairs inside a row. Edge streams MPEG-2 layer III at 24 kHz,
# 48 kbit/s, mono; a frame of that format with zeroed side info decodes to
# 24 ms of silence, so the player plays it like any other audio.
ROW_SILENCE_S = 0.7
_SILENT_FRAME = b"\xff\xf3\x64\xc0" + bytes(140)
ROW_SILENCE = _SILENT_FRAME * round(ROW_SILENCE_S / 0.024)


class PlayerError(Exception):
    """The audio player failed: no endpoint can fix that."""


# How the text reaches the ear. Measured in November 2026: about one
# connection in thirty to Microsoft lands on a slow server. It sends its first
# audio after 5 to 10 seconds instead of 1, then slower than the voice speaks,
# while a connection opened at the same moment is fast. Audio piped straight
# from one connection into the player therefore stopped in the middle of
# words. So:
#   1. the text is cut into units of whole sentences, each fetched on its own
#      connection, a few of them ahead of the voice;
#   2. a unit reaches the player only once all of it has arrived, so the voice
#      can pause between two sentences but never inside a word;
#   3. a connection that is slow to start or to finish is raced by a fresh
#      one, and the first to deliver the whole unit wins.

# Characters per unit: the first is short so the voice starts quickly.
UNIT_CHARS = (150, 300, 450)
LONG_SENTENCE = 600        # a sentence beyond this is cut at a comma or space
PARALLEL = 2               # units fetched at the same time
LOOKAHEAD_S = 120          # audio fetched ahead of the voice, at most
CHARS_PER_S = 14           # rough reading speed, to estimate a unit's length
AUDIO_BYTES_PER_S = 6000   # Edge's 48 kbit/s

# A healthy connection sends its first audio within about 1 second and the
# rest of a unit within 1 more.
SLOW_FIRST_S = 1.8
SLOW_REST_S = 2.0
# Microsoft refuses a client that opens many connections at once (eight reads
# started together in a test were all refused), so both numbers stay small:
# four connections at the very most.
RACERS = 2                 # connections working on one unit, at most
# Failed connections a unit survives once the voice has started: stopping
# mid-read is worse than a pause. Before that, one per endpoint and one more
# (Microsoft's 429 Too Many Requests is often momentary), so a dead service
# hands over to the next voice quickly.
PATIENT_TRIES = 6
RECEIVE_TIMEOUT = 20

_RE_SENTENCE_END = re.compile(r'[.!?…。！？]+["\'”’»)\]]*\s+|\n+')
# A full stop that ends an abbreviation or an initial, not a sentence.
_RE_ABBREVIATION = re.compile(
    r'(?:\b[A-Za-z]|\b(?:Mr|Mrs|Ms|Dr|Prof|St|vs|etc|No|cf|Fig|approx|Mme'
    r'|Mlle|e\.g|i\.e))\.["\'”’»)\]]*\s+$')
_RE_SPEAKABLE = re.compile(r'\w')


def sentences(text):
    """Cut text where a voice would end a sentence, keeping every character."""
    out = []
    start = 0
    for m in _RE_SENTENCE_END.finditer(text):
        end = m.end()
        if end >= len(text):
            break
        if "\n" not in m.group() and (
                text[end].islower()
                or _RE_ABBREVIATION.search(text, start, end)):
            continue
        out.append(text[start:end])
        start = end
    out.append(text[start:])
    cut = []
    for part in out:
        while len(part) > LONG_SENTENCE:
            head = part[:UNIT_CHARS[-1]]
            at = max(head.rfind(", "), head.rfind("; "), head.rfind(": "))
            if at < 0:
                at = head.rfind(" ")
            at = at + 1 if at >= 0 else len(head)
            cut.append(part[:at])
            part = part[at:]
        cut.append(part)
    return cut


def split_units(text):
    """Group whole sentences into units, each with something to say."""
    units = []
    buf = ""
    for part in sentences(text):
        limit = UNIT_CHARS[min(len(units), len(UNIT_CHARS) - 1)]
        if (len(buf) + len(part) > limit and _RE_SPEAKABLE.search(buf)
                and _RE_SPEAKABLE.search(part)):
            units.append(buf.strip())
            buf = ""
        buf += part
    if _RE_SPEAKABLE.search(buf):
        units.append(buf.strip())
    return units


class Playback:
    """The audio player, fed whole units by its own thread, so fetching
    never waits on playing."""

    def __init__(self):
        self.cond = threading.Condition()
        self.queue = []       # whole units the player has not been given yet
        self.fed = False
        self.done = False     # everything has been fed
        self.aborted = False
        self.error = None     # PlayerError raised in the thread
        self.player = None
        self.thread = None
        self.dry_at = 0.0     # when the audio the player has runs out
        self.first_sound = None
        self.gaps = []        # seconds the player sat with nothing to play

    @property
    def started(self):
        """Whether any audio reached the player."""
        return self.player is not None

    def ahead(self):
        """Seconds of audio fed but not played yet."""
        with self.cond:
            queued = sum(len(data) for data in self.queue)
        return (max(0.0, self.dry_at - time.monotonic())
                + queued / AUDIO_BYTES_PER_S)

    def feed(self, data):
        """Hand over a whole unit: a pause after it is fine."""
        with self.cond:
            if self.error is not None:
                raise self.error
            self.queue.append(data)
            self.fed = True
            self.cond.notify()
        if self.thread is None:
            self.thread = threading.Thread(target=self._run, daemon=True)
            self.thread.start()

    def finish(self):
        """Play out everything fed; raises PlayerError if the player failed."""
        with self.cond:
            self.done = True
            self.cond.notify()
        if self.thread is not None:
            self.thread.join()
        if self.error is not None:
            raise self.error

    def close(self):
        """Stop at once: whatever is still waiting or playing is dropped."""
        with self.cond:
            self.aborted = True
            self.cond.notify()
        if self.thread is not None:
            # Until the thread is gone it may still be starting the player.
            while self.thread.is_alive():
                self._kill_player()
                self.thread.join(0.05)
        self._kill_player()

    def _kill_player(self):
        if self.player is not None and self.player.poll() is None:
            self.player.kill()
            self.player.wait()
            try:
                self.player.stdin.close()   # drops what it never took
            except OSError:
                pass

    def _next(self):
        with self.cond:
            while not (self.queue or self.done or self.aborted):
                self.cond.wait()
            if self.aborted or not self.queue:
                return None
            data = b"".join(self.queue)
            self.queue.clear()
            return data

    def _run(self):
        try:
            while True:
                data = self._next()
                if data is None:
                    break
                now = time.monotonic()
                if self.player is None:
                    # Started on the first audio, so a service that refuses
                    # never leaves an empty player complaining.
                    try:
                        self.player = subprocess.Popen(
                            PLAYER_CMD, stdin=subprocess.PIPE)
                    except OSError as exc:
                        raise PlayerError(
                            f"Can't start the audio player: {exc}")
                    self.first_sound = time.time()
                elif now - self.dry_at > 0.15:
                    self.gaps.append(round(now - self.dry_at, 1))
                self.dry_at = (max(self.dry_at, now)
                               + len(data) / AUDIO_BYTES_PER_S)
                self.player.stdin.write(data)
                self.player.stdin.flush()
            if self.player is not None and not self.aborted:
                self.player.stdin.close()
                if self.player.wait() > 0:
                    raise PlayerError("The audio player failed "
                                      f"(exit {self.player.returncode}).")
        except PlayerError as exc:
            self._fail(exc)
        except (BrokenPipeError, ValueError):
            # Killed by a signal = a Stop, which takes us down with it anyway.
            if not self.aborted and self.player.wait() > 0:
                self._fail(PlayerError("The audio player quit unexpectedly."))
        except Exception as exc:
            self._fail(PlayerError(f"The audio player failed: {exc}"))

    def _fail(self, exc):
        with self.cond:
            self.error = exc


# One line per read in LOG_FILE: when a pause is heard, it says whether the
# service, the network or the player was behind it.
LOG_FILE = os.path.join(CONFIG_DIR, "read-aloud.log")
LOG_MAX_BYTES = 200_000
STARTED = time.time()     # when this process, or the one it reads for, began
_read = None    # the read in progress: what its log line is built from


def write_log(outcome):
    """Append the line of the read in progress, once."""
    global _read
    read, _read = _read, None
    if read is None:
        return
    playback = read["playback"]
    first = playback.first_sound
    line = (f"{time.strftime('%Y-%m-%d %H:%M:%S')} {outcome}"
            f"{' standby' if SERVING else ''}"
            f" chars={read['chars']} units={read['units']}"
            f" first_sound={'-' if first is None else f'{first - STARTED:.2f}s'}"
            f" took={time.time() - STARTED:.1f}s"
            f" raced={read['raced']} errors={len(read['errors'])}"
            f" pauses={playback.gaps} voice={read['voice']}\n")
    try:
        if os.path.getsize(LOG_FILE) > LOG_MAX_BYTES:
            with open(LOG_FILE, "rb") as f:
                f.seek(-LOG_MAX_BYTES // 2, os.SEEK_END)
                tail = f.read().split(b"\n", 1)[-1]
            with open(LOG_FILE, "wb") as f:
                f.write(tail)
    except OSError:
        pass
    try:
        with open(LOG_FILE, "a") as f:
            f.write(line)
    except OSError:
        pass


def _on_stop(signum, frame):
    """A Stop: note it, then die of the signal as before."""
    write_log("stopped")
    signal.signal(signum, signal.SIG_DFL)
    os.kill(os.getpid(), signum)


def endpoints():
    """Synthesis URLs to try, in order: the last one that worked, the
    installed library's own, then every known host."""
    import edge_tts.communicate as comm
    from edge_tts.constants import TRUSTED_CLIENT_TOKEN
    urls = []
    try:
        with open(LAST_ENDPOINT_FILE) as f:
            urls.append(f.read().strip())
    except OSError:
        pass
    urls.append(comm.WSS_URL)
    urls += [t.format(token=TRUSTED_CLIENT_TOKEN) for t in EDGE_ENDPOINTS]
    return [u for u in dict.fromkeys(urls) if u.startswith("wss://")]


def remember_endpoint(url):
    """Try this endpoint first next time: a dead one then costs one failed
    handshake, once, instead of one on every read."""
    try:
        with open(LAST_ENDPOINT_FILE) as f:
            if f.read().strip() == url:
                return
    except OSError:
        pass
    try:
        with open(LAST_ENDPOINT_FILE, "w") as f:
            f.write(url)
    except OSError:
        pass


def edge_tts_version():
    """Installed edge-tts version, read fresh from disk."""
    import importlib
    import importlib.metadata
    importlib.invalidate_caches()
    try:
        return importlib.metadata.version("edge-tts")
    except importlib.metadata.PackageNotFoundError:
        return None


def upgrade_edge_tts(wait=UPGRADE_WAIT):
    """Install the newest edge-tts into this interpreter's environment.
    Returns True when a different version is installed within `wait` seconds;
    with wait=0 the upgrade is only started."""
    try:
        if time.time() - os.path.getmtime(UPGRADE_STAMP) < UPGRADE_INTERVAL:
            return False
    except OSError:
        pass
    os.makedirs(CONFIG_DIR, exist_ok=True)
    with open(UPGRADE_STAMP, "w"):
        pass
    before = edge_tts_version()
    try:
        # Own session, never killed: a Stop kills our process group, and pip
        # killed mid-install would leave edge-tts half-written for good.
        pip = subprocess.Popen(
            [sys.executable, "-m", "pip", "install", "--quiet",
             "--disable-pip-version-check", "--upgrade", "edge-tts"],
            stdin=subprocess.DEVNULL, stdout=subprocess.DEVNULL,
            stderr=subprocess.DEVNULL, start_new_session=True)
        if not wait:
            return False
        pip.wait(timeout=wait)
    except (OSError, subprocess.TimeoutExpired):
        return False
    return edge_tts_version() != before


def failure_reason(exc):
    """One short, user-facing line for a failed synthesis."""
    # aiohttp's handshake error stringifies to the whole signed URL; the
    # status alone says everything worth showing.
    status = getattr(exc, "status", None)
    if status:
        return f"Microsoft's voice service refused the request (HTTP {status})."
    if isinstance(exc, ImportError):
        return "The edge-tts library is missing or broken."
    return (str(exc) or type(exc).__name__)[:160]


async def fetch_once(text, voice, rate, pitch, volume, urls, read, attempt):
    """The whole audio of one unit over one connection."""
    from contextlib import aclosing
    import edge_tts
    import edge_tts.communicate as comm
    at = read["url"]
    comm.WSS_URL = urls[at % len(urls)]
    audio = bytearray()
    try:
        communicate = edge_tts.Communicate(
            text, voice, rate=rate, pitch=pitch, volume=volume,
            connect_timeout=CONNECT_TIMEOUT, receive_timeout=RECEIVE_TIMEOUT)
        # aclosing: being cancelled must still close the connection.
        async with aclosing(communicate.stream()) as stream:
            async for chunk in stream:
                if chunk["type"] == "audio":
                    if attempt["first"] is None:
                        attempt["first"] = time.monotonic()
                    audio += chunk["data"]
    except Exception:
        # The next connection goes to the next endpoint.
        if read["url"] == at:
            read["url"] = at + 1
        raise
    read["good_url"] = urls[at % len(urls)]
    return bytes(audio)


def is_slow(attempt):
    now = time.monotonic()
    if attempt["first"] is None:
        return now - attempt["start"] > SLOW_FIRST_S
    return now - attempt["first"] > SLOW_REST_S


async def fetch_unit(text, voice, rate, pitch, volume, urls, read):
    """The whole audio of one unit, racing a slow connection with a fresh
    one and replacing a failed one, a little later each time."""
    import asyncio
    racers = {}   # task -> attempt
    failures = 0

    def connect():
        attempt = {"start": time.monotonic(), "first": None}
        racers[asyncio.create_task(fetch_once(
            text, voice, rate, pitch, volume, urls, read, attempt))] = attempt

    connect()
    try:
        while True:
            done, _ = await asyncio.wait(
                racers, timeout=0.2, return_when=asyncio.FIRST_COMPLETED)
            for task in done:
                del racers[task]
                if task.exception() is None:
                    return task.result()
                read["errors"].append(task.exception())
                failures += 1
                if failures > (PATIENT_TRIES if read["playback"].started
                               else len(urls)):
                    raise task.exception()
            if not racers:
                if failures > 1:
                    await asyncio.sleep(min(2.0, 0.5 * (failures - 1)))
                connect()
            elif len(racers) < RACERS and all(map(is_slow, racers.values())):
                read["raced"] += 1
                connect()
    finally:
        for task in racers:
            task.cancel()
        await asyncio.gather(*racers, return_exceptions=True)


async def read_aloud(pieces, voice, rate, pitch, volume, urls, read):
    """Fetch every unit and play them in order, with ROW_SILENCE between
    pieces. Returns the exception that stopped the read, or None."""
    import asyncio
    playback = read["playback"]
    units = []    # (text, first of a later piece)
    for n, piece in enumerate(pieces):
        for k, text in enumerate(split_units(piece)):
            units.append((text, bool(n) and k == 0))
    read["units"] = len(units)
    tasks = {}    # unit number -> its fetch
    launched = 0
    error = None
    try:
        for n, (_, new_piece) in enumerate(units):
            while not tasks[n].done() if n in tasks else True:
                fetching = sum(len(units[i][0]) for i in tasks) / CHARS_PER_S
                while (launched < len(units) and len(tasks) < PARALLEL
                       and (launched == n or playback.ahead() + fetching
                            < LOOKAHEAD_S)):
                    tasks[launched] = asyncio.create_task(fetch_unit(
                        units[launched][0], voice, rate, pitch, volume,
                        urls, read))
                    fetching += len(units[launched][0]) / CHARS_PER_S
                    launched += 1
                await asyncio.wait([tasks[n]], timeout=1.0)
            audio = tasks.pop(n).result()
            if new_piece and playback.fed:
                audio = ROW_SILENCE + audio
            playback.feed(audio)
        # Off the event loop: it must not sit blocked for the whole read.
        await asyncio.get_running_loop().run_in_executor(
            None, playback.finish)
    except Exception as exc:
        error = exc
    finally:
        for task in tasks.values():
            task.cancel()
        await asyncio.gather(*tasks.values(), return_exceptions=True)
        playback.close()
    return error


def speak_edge(pieces, voice, rate, pitch, volume):
    """Read the pieces aloud.

    Returns (spoke, errors, played): errors holds every failed connection,
    also the ones another connection made up for; played, whether any audio
    reached the player. Once it has, another voice would start over.
    """
    global _read
    import asyncio
    try:
        urls = endpoints()
    except ImportError as exc:
        return False, [exc], False
    playback = Playback()
    read = {"playback": playback, "url": 0, "good_url": None, "errors": [],
            "raced": 0, "units": 0, "voice": voice,
            "chars": sum(map(len, pieces))}
    _read = read
    error = asyncio.run(
        read_aloud(pieces, voice, rate, pitch, volume, urls, read))
    errors = read["errors"]
    if error is None:
        write_log("ok")
        if read["good_url"]:
            remember_endpoint(read["good_url"])
        return True, errors, playback.started
    if not errors or errors[-1] is not error:
        errors.append(error)
    write_log(f"failed({failure_reason(error)[:60]})")
    return False, errors, playback.started


def worth_upgrading(errors):
    """An HTTP refusal is how a Microsoft protocol change shows up, and a
    missing library is reinstalled by the same pip run."""
    return any(getattr(e, "status", None) or isinstance(e, ImportError)
               for e in errors)


def voice_locale(voice):
    """"fr-FR-HenriNeural" -> "fr-FR"."""
    return "-".join(voice.split("-")[:2])


def read_text(text, args):
    """Read the text aloud. Returns (status, played): status 1 when nothing
    could read it (reason on stderr), None when Edge could not start and
    `args["edge_only"]` leaves the other voices to the caller."""
    load_tools()
    # Load settings, CLI args take priority
    settings = load_settings()
    voice = auto_voice(text, settings, args["voice"])
    rate = args["rate"] or settings["rate"]
    pitch = args["pitch"] or settings["pitch"]
    volume = args["volume"] or settings.get("volume", "+0%")

    if tts_text is not None:
        pieces = tts_text.split_breaks(tts_text.clean_text_for_speech(
            text, tts_text.speech_lang(text, voice), breaks=True))
    else:
        pieces = [text.strip()] if text.strip() else []
    if not pieces:
        return 0

    spoke, errors, played = speak_edge(pieces, voice, rate, pitch, volume)
    if spoke:
        # A refusal on the way there means this edge-tts is falling
        # behind Microsoft: start its update, without waiting on it.
        if worth_upgrading(errors):
            upgrade_edge_tts(wait=0)
        return 0
    if not played and args.get("edge_only"):
        return None
    if (tts_fallback is not None and not played
            and worth_upgrading(errors) and upgrade_edge_tts()):
        # A fresh process, so the upgraded edge-tts is the one imported.
        tts_fallback.exec_with_stdin(
            [sys.executable, os.path.abspath(__file__), "--stdin",
             "--voice", voice, "--rate", rate, "--pitch", pitch,
             "--volume", volume],
            text)
    reason = failure_reason(errors[-1])
    # Scribe and speak-selection.sh show this line to the user when
    # nothing else speaks either, so a dead service is never silent.
    print(f"[edge-tts] {reason}", file=sys.stderr)
    if played and not isinstance(errors[-1], PlayerError):
        return 1  # cut off mid-read: another voice would start it over
    if tts_fallback is None:
        return 1
    tts_fallback.notify("Read aloud: using the Mac's voice",
                        f"Microsoft Edge failed: {reason}")
    # The Mac's own voice cannot take silences: it reads one text
    if tts_fallback.speak_with_system_voice(
            "\n\n".join(pieces), voice_locale(voice)):
        return 0
    print(f"[edge-tts] {reason} The Mac's own voice failed too.",
          file=sys.stderr)
    return 1


# The standby. Loading edge-tts takes this helper 0.2 s, a fifth of the wait
# for the first word. So each read leaves behind one process that has it
# loaded already and waits for the next read on a socket; that read's own
# process only passes it the text and waits. A standby reads once, and is
# replaced by a fresh one that has the current code and settings. Nobody
# reading for STANDBY_IDLE_S: it exits, and the next read loads edge-tts
# itself, as before.
STANDBY_SOCKET = os.path.join(CONFIG_DIR, "standby.sock")
STANDBY_LOCK = os.path.join(CONFIG_DIR, "standby.lock")
STANDBY_IDLE_S = 600
STANDBY_SPAWN_AFTER_S = 2.0   # once this read's own loading is done
SERVING = False               # whether this process is a standby at work
ME = os.path.abspath(__file__)


def my_version():
    """Changes whenever this file does: a standby from before an update must
    not read with the old code."""
    try:
        return os.path.getmtime(ME)
    except OSError:
        return 0


def spawn_standby():
    try:
        subprocess.Popen(
            [sys.executable, ME, "--standby"], stdin=subprocess.DEVNULL,
            stdout=subprocess.DEVNULL, stderr=subprocess.DEVNULL,
            start_new_session=True)
    except OSError:
        pass


def spawn_standby_later():
    timer = threading.Timer(STANDBY_SPAWN_AFTER_S, spawn_standby)
    timer.daemon = True
    timer.start()


def _receive(sock):
    """One message: its length on 10 digits, then JSON."""
    def exactly(n):
        data = b""
        while len(data) < n:
            block = sock.recv(n - len(data))
            if not block:
                raise OSError("closed")
            data += block
        return data
    return json.loads(exactly(int(exactly(10))))


def _send(sock, message):
    data = json.dumps(message).encode()
    sock.sendall(b"%010d" % len(data) + data)


def ask_standby(text, args):
    """Have the standby read the text. Returns its exit status, or None when
    there is no standby or it could not start: then we read it ourselves."""
    import socket
    sock = socket.socket(socket.AF_UNIX, socket.SOCK_STREAM)
    try:
        sock.settimeout(0.3)
        sock.connect(STANDBY_SOCKET)
        _send(sock, {"text": text, "args": args, "started": STARTED,
                     "version": my_version()})
        # Our being killed (a Stop) closes the socket, which stops the standby.
        sock.settimeout(None)
        answer = _receive(sock)
    except (OSError, ValueError):
        return None
    finally:
        sock.close()
    if answer.get("stderr"):
        sys.stderr.write(answer["stderr"])
    return answer.get("status")


def standby():
    """Load everything, wait for one read, do it."""
    global STARTED, SERVING
    import asyncio  # noqa: F401  (loaded now, so the read does not wait on it)
    import fcntl
    import io
    import socket
    import edge_tts  # noqa: F401
    load_tools()
    version = my_version()

    os.makedirs(CONFIG_DIR, exist_ok=True)
    lock = open(STANDBY_LOCK, "w")
    try:
        fcntl.flock(lock, fcntl.LOCK_EX | fcntl.LOCK_NB)
    except OSError:
        return 0  # there is a standby already
    server = socket.socket(socket.AF_UNIX, socket.SOCK_STREAM)
    try:
        os.unlink(STANDBY_SOCKET)
    except OSError:
        pass
    try:
        server.bind(STANDBY_SOCKET)
        server.listen(1)
        server.settimeout(STANDBY_IDLE_S)
        conn, _ = server.accept()
    except OSError:
        conn = None
    # Whatever happens next, the place is free for the next standby.
    server.close()
    try:
        os.unlink(STANDBY_SOCKET)
    except OSError:
        pass
    lock.close()
    if conn is None:
        return 0

    try:
        conn.settimeout(5)
        job = _receive(conn)
        conn.settimeout(None)
    except (OSError, ValueError):
        return 0
    if job.get("version") != version or version != my_version():
        _send(conn, {"status": None})
        return 0
    spawn_standby_later()
    STARTED = job["started"]
    SERVING = True

    def stop_with_the_asker():
        # Nothing more is sent to us: the socket closing means the process
        # that asked is gone, killed by a Stop or a newer read.
        try:
            conn.recv(1)
        except OSError:
            pass
        write_log("stopped")
        # Our group: us, the player, the Mac's voice if it took over. The
        # next standby has its own.
        os.killpg(os.getpgrp(), signal.SIGKILL)

    threading.Thread(target=stop_with_the_asker, daemon=True).start()
    stderr, sys.stderr = sys.stderr, io.StringIO()
    try:
        status = read_text(job["text"], dict(job["args"], edge_only=True))
    except Exception as exc:
        status = None
        print(f"[edge-tts] standby: {exc}", file=stderr)
    try:
        _send(conn, {"status": status, "stderr": sys.stderr.getvalue()})
    except OSError:
        pass
    return 0


def main():
    """Exit status: 1 when nothing could read the text (reason on stderr),
    else 0."""
    args = parse_args()

    if args["stop"]:
        stop_existing()
        return
    if args["standby"]:
        return standby()

    # Stop any existing speech first
    stop_existing()
    claim()
    signal.signal(signal.SIGTERM, _on_stop)

    try:
        text = sys.stdin.read() if args["stdin"] else args["text"]
        if not text:
            return
        options = {k: args[k] for k in ("voice", "rate", "pitch", "volume")}
        try:
            status = ask_standby(text, options)
            if status is None:
                spawn_standby_later()
                status = read_text(text, options)
        except (KeyboardInterrupt, SystemExit):
            return
        return status
    finally:
        release()


if __name__ == "__main__":
    sys.exit(main())
