#!/Users/avi/.local/pipx/venvs/edge-tts/bin/python
"""
Stream edge-tts audio with minimal latency and reliable stop.

Uses process groups and a PID file for clean stop from any source.
"""
import json
import os
import re
import signal
import subprocess
import sys
import time

CONFIG_DIR = os.path.expanduser("~/.config/speak-selection")
SETTINGS_FILE = os.path.join(CONFIG_DIR, "settings.json")
CONFIG_FILE = os.path.join(CONFIG_DIR, "config")
PID_FILE = os.path.join(CONFIG_DIR, "speak.pid")

PLAYER_CMD = ["/opt/homebrew/bin/play", "-t", "mp3", "-q", "-"]


def stop_existing():
    """Kill any currently running speech process group. SIGTERM first,
    escalate to SIGKILL if the group survives."""
    try:
        with open(PID_FILE) as f:
            pgid = int(f.read().strip())
    except (OSError, ValueError):
        return
    # Never kill our own group: a stale/corrupt PID file pointing at the
    # caller's group would otherwise take down the menubar app itself.
    if pgid != os.getpgrp():
        try:
            os.killpg(pgid, signal.SIGTERM)
        except (ProcessLookupError, PermissionError):
            pass
        else:
            for _ in range(10):
                time.sleep(0.05)
                try:
                    os.killpg(pgid, 0)
                except (ProcessLookupError, PermissionError):
                    break
            else:
                try:
                    os.killpg(pgid, signal.SIGKILL)
                except (ProcessLookupError, PermissionError):
                    pass
    try:
        os.unlink(PID_FILE)
    except OSError:
        pass


def parse_args():
    """Fast arg parsing without argparse."""
    args = {"stop": False, "text": None, "stdin": False, "voice": None,
            "rate": None, "pitch": None, "volume": None}
    i = 1
    while i < len(sys.argv):
        a = sys.argv[i]
        if a == "--stop":
            args["stop"] = True
        elif a == "--stdin":
            args["stdin"] = True
        elif a == "--text" and i + 1 < len(sys.argv):
            i += 1
            args["text"] = sys.argv[i]
        elif a.startswith("--text="):
            args["text"] = a[7:]
        elif a == "--voice" and i + 1 < len(sys.argv):
            i += 1
            args["voice"] = sys.argv[i]
        elif a.startswith("--voice="):
            args["voice"] = a[8:]
        elif a == "--rate" and i + 1 < len(sys.argv):
            i += 1
            args["rate"] = sys.argv[i]
        elif a.startswith("--rate="):
            args["rate"] = a[7:]
        elif a == "--pitch" and i + 1 < len(sys.argv):
            i += 1
            args["pitch"] = sys.argv[i]
        elif a.startswith("--pitch="):
            args["pitch"] = a[8:]
        elif a == "--volume" and i + 1 < len(sys.argv):
            i += 1
            args["volume"] = sys.argv[i]
        elif a.startswith("--volume="):
            args["volume"] = a[9:]
        i += 1
    return args


# Shared language detector, deployed next to this script. Optional on
# purpose: if it is missing we simply speak with the configured voice, which
# is what this helper did before per-language voices existed.
try:
    import tts_lang
except Exception:
    tts_lang = None

# Shared fallbacks (the Mac's own voice, notifications), deployed alongside.
# Optional too: without it a failure is reported instead of worked around.
try:
    import tts_fallback
except Exception:
    tts_fallback = None


def auto_voice(text, settings, explicit):
    """Voice to speak `text` with: an explicit --voice always wins.

    Mirrors scribe_core.resolve_tts_voice so the ⌃D Quick Action and the app
    menu pick the same voice for the same text.
    """
    if explicit:
        return explicit
    default = settings["voice"]
    if tts_lang is None or not settings.get("tts_autodetect", True):
        return default
    try:
        lang = tts_lang.detect_language(text)
        return tts_lang.voice_for_lang(
            settings.get("edge_voice_by_lang"), lang, default,
            settings.get("edge_lang_defaults"))
    except Exception:
        return default


def load_settings():
    """Load voice/rate/pitch/volume from config."""
    settings = {"voice": "en-US-BrianNeural", "rate": "+0%",
                "pitch": "+0Hz", "volume": "+0%",
                "edge_voice_by_lang": {}, "edge_lang_defaults": {},
                "tts_autodetect": True}
    if os.path.exists(SETTINGS_FILE):
        try:
            with open(SETTINGS_FILE) as f:
                settings.update(json.load(f))
        except Exception:
            pass
    elif os.path.exists(CONFIG_FILE):
        try:
            with open(CONFIG_FILE) as f:
                for line in f:
                    line = line.strip()
                    if "=" in line and not line.startswith("#"):
                        key, val = line.split("=", 1)
                        key = key.strip().lower()
                        val = val.strip().strip('"').strip("'")
                        if key in settings:
                            settings[key] = val
        except Exception:
            pass
    return settings


# --- Text cleaning for speech (compiled once at import) ---

# Markdown images ![alt](url) -> alt text only
_RE_MD_IMAGE = re.compile(r'!\[([^\]]*)\]\([^)]+\)')
# Markdown links [text](url) -> text only
_RE_MD_LINK = re.compile(r'\[([^\]]*)\]\([^)]+\)')
# HTML tags
_RE_HTML_TAG = re.compile(r'<[^>]+>')
# Code fences (``` optionally with language)
_RE_CODE_FENCE = re.compile(r'```[a-zA-Z]*')
# Heading markers at start of line (# ## ### etc)
_RE_HEADING = re.compile(r'(?m)^#{1,6}\s+')
# Blockquote markers at start of line
_RE_BLOCKQUOTE = re.compile(r'(?m)^>\s*')
# Bullet/list markers at start of line (- or * followed by space)
_RE_BULLET = re.compile(r'(?m)^[\-\*]\s+')
# Numbered list markers at start of line (1. 2. etc)
_RE_NUMBERED = re.compile(r'(?m)^\d+\.\s+')
# Bold/italic markers (*** ** * ___ __ but NOT underscores inside words)
_RE_BOLD_ITALIC = re.compile(r'(?<!\w)[_*]{1,3}(?!\w)|(?<!\w)[_*]{1,3}(?=\w)|(?<=\w)[_*]{1,3}(?!\w)')
# Inline code backticks
_RE_INLINE_CODE = re.compile(r'`([^`]+)`')
# Horizontal rules (--- *** ___ on their own line)
_RE_HR = re.compile(r'(?m)^[\-\*_]{3,}\s*$')
# URLs: https://example.com/some_path -> "example dot com, some path"
_RE_URL = re.compile(r'https?://([^\s\)\]]+)')
# Remaining noisy characters (pipes, tildes, backslashes)
_RE_NOISE = re.compile(r'[|~\\]')
# Emojis and pictographic symbols (Unicode blocks for emoji)
_RE_EMOJI = re.compile(
    r'[\U0001F600-\U0001F64F'   # emoticons
    r'\U0001F300-\U0001F5FF'    # misc symbols & pictographs
    r'\U0001F680-\U0001F6FF'    # transport & map symbols
    r'\U0001F1E0-\U0001F1FF'    # flags
    r'\U0001F900-\U0001F9FF'    # supplemental symbols
    r'\U0001FA00-\U0001FA6F'    # chess symbols, extended-A
    r'\U0001FA70-\U0001FAFF'    # symbols extended-A continued
    r'\U00002702-\U000027B0'    # dingbats
    r'\U0000FE00-\U0000FE0F'    # variation selectors
    r'\U0000200D'               # zero width joiner
    r'\U000020E3'               # combining enclosing keycap
    r'\U00002600-\U000026FF'    # misc symbols (☀⚠☎ etc)
    r'\U00002300-\U000023FF'    # misc technical (⌘⌛ etc)
    r'\U00002B50-\U00002B55'    # stars, circles
    r'\U0000203C-\U00003299'    # CJK symbols, enclosed chars
    r']+', re.UNICODE
)
# Collapse multiple spaces/newlines
_RE_MULTI_SPACE = re.compile(r'[ \t]{2,}')
_RE_MULTI_NEWLINE = re.compile(r'\n{3,}')


def _humanize_url(match):
    """Turn a URL into something speakable."""
    url = match.group(1)
    # Strip trailing punctuation that's not part of the URL
    url = url.rstrip('.,;:!?')
    # Remove common prefixes
    url = re.sub(r'^www\.', '', url)
    # Split path from domain
    parts = url.split('/', 1)
    domain = parts[0]
    # Domain: replace dots with " dot "
    domain = domain.replace('.', ' dot ')
    if len(parts) > 1 and parts[1]:
        path = parts[1]
        # Clean path: drop trailing slashes, replace separators with spaces
        path = path.strip('/')
        path = path.replace('_', ' ').replace('-', ' ').replace('/', ', ')
        # File extensions: .md -> " dot md", .py -> " dot py"
        path = re.sub(r'\.([a-zA-Z]{2,4})$', r' dot \1', path)
        # Drop query strings and fragments
        path = re.sub(r'[?#].*', '', path)
        if path.strip():
            return f"{domain}, {path}"
    return domain


def _format_table_for_speech(text):
    """Detect tables and reformat them for natural flowing narration.

    Reads headers once, then each row as a concise sentence:
      2 cols: "Table: Name and Age. Alice, 30. Bob, 25."
      3+ cols: "Table: Feature, Free, and Pro. Storage: Free 5GB, Pro 50GB."
    """
    lines = text.split('\n')
    result = []
    i = 0

    def _header_intro(headers):
        """Natural header list with Oxford comma."""
        if len(headers) == 1:
            return headers[0]
        if len(headers) == 2:
            return f"{headers[0]} and {headers[1]}"
        return ', '.join(headers[:-1]) + f', and {headers[-1]}'

    def _narrate_rows(headers, table_lines, split_fn):
        """Convert table rows into flowing speech."""
        n_cols = len(headers)
        result.append(f"Table: {_header_intro(headers)}.")
        result.append('')

        for row_line in table_lines:
            cells = split_fn(row_line)
            while len(cells) < n_cols:
                cells.append('')
            cells = cells[:n_cols]

            non_empty = [(h, c) for h, c in zip(headers, cells) if c]
            if not non_empty:
                continue

            if n_cols <= 2:
                # Short table: just list values, headers implied from intro
                result.append(', '.join(c for _, c in non_empty) + '.')
            else:
                # Wider table: first cell anchors, rest get header prefix
                first_val = non_empty[0][1]
                rest = [f"{h} {c}" for h, c in non_empty[1:]]
                if rest:
                    result.append(f"{first_val}: {', '.join(rest)}.")
                else:
                    result.append(f"{first_val}.")
            result.append('')

    while i < len(lines):
        line = lines[i].strip()

        # Detect markdown table: line with | delimiters
        if '|' in line and line.count('|') >= 2:
            table_lines = []
            while i < len(lines):
                l = lines[i].strip()
                if '|' not in l or l.count('|') < 2:
                    break
                table_lines.append(l)
                i += 1

            if len(table_lines) >= 2:
                headers = [c.strip() for c in table_lines[0].strip('|').split('|')]
                headers = [h for h in headers if h]

                # Skip separator row (e.g., |---|---|)
                data_start = 1
                if data_start < len(table_lines):
                    sep = table_lines[data_start].replace('|', '').replace('-', '').replace(':', '').strip()
                    if not sep:
                        data_start = 2

                def md_split(row_line):
                    cells = [c.strip() for c in row_line.strip('|').split('|')]
                    return [c for c in cells if c or len(cells) <= len(headers)]

                _narrate_rows(headers, table_lines[data_start:], md_split)
                continue
            else:
                for tl in table_lines:
                    result.append(tl)
                continue

        # Detect tab-separated table (e.g., copied from spreadsheet)
        elif '\t' in line and i + 1 < len(lines) and '\t' in lines[i + 1].strip():
            table_lines = []
            while i < len(lines):
                l = lines[i]
                if '\t' not in l and l.strip():
                    break
                if l.strip():
                    table_lines.append(l)
                i += 1

            if len(table_lines) >= 2:
                headers = [c.strip() for c in table_lines[0].split('\t')]
                headers = [h for h in headers if h]

                def tsv_split(row_line):
                    return [c.strip() for c in row_line.split('\t')]

                _narrate_rows(headers, table_lines[1:], tsv_split)
                continue
            else:
                for tl in table_lines:
                    result.append(tl)
                continue

        else:
            result.append(lines[i])
            i += 1

    return '\n'.join(result)


def clean_text_for_speech(text):
    """Strip markdown/URL noise so TTS reads cleanly."""
    # Strip emojis first — TTS reads their Unicode names ("white heavy check mark")
    text = _RE_EMOJI.sub('', text)
    # Tables — before pipe characters get stripped as noise
    text = _format_table_for_speech(text)
    # Images first (before links, since ![...] contains [...])
    text = _RE_MD_IMAGE.sub(r'\1', text)
    # Links: keep the display text
    text = _RE_MD_LINK.sub(r'\1', text)
    # HTML tags
    text = _RE_HTML_TAG.sub('', text)
    # Code fences
    text = _RE_CODE_FENCE.sub('', text)
    # Horizontal rules
    text = _RE_HR.sub('', text)
    # Headings (strip the # markers, keep the text)
    text = _RE_HEADING.sub('', text)
    # Blockquotes
    text = _RE_BLOCKQUOTE.sub('', text)
    # Bullet markers
    text = _RE_BULLET.sub('', text)
    # Numbered list markers
    text = _RE_NUMBERED.sub('', text)
    # Inline code: keep the content, drop the backticks
    text = _RE_INLINE_CODE.sub(r'\1', text)
    # Bold/italic markers
    text = _RE_BOLD_ITALIC.sub('', text)
    # URLs -> human readable
    text = _RE_URL.sub(_humanize_url, text)
    # Underscores between words -> spaces (e.g., my_function -> my function)
    text = re.sub(r'(?<=\w)_(?=\w)', ' ', text)
    # Remaining noise characters
    text = _RE_NOISE.sub('', text)
    # Stray hashes that aren't part of words (e.g., leftover #)
    text = re.sub(r'(?<!\w)#(?!\w)', '', text)
    # Clean up whitespace
    text = _RE_MULTI_SPACE.sub(' ', text)
    text = _RE_MULTI_NEWLINE.sub('\n\n', text)
    return text.strip()


# Read aloud must not hinge on any one thing Microsoft controls. In order:
#   1. every synthesis endpoint, starting with the last one that worked;
#   2. if they all refuse (or edge-tts is missing), a freshly upgraded
#      edge-tts. Microsoft changes what it accepts every few months (October
#      2026: a new Sec-MS-GEC token), upstream usually ships the fix within a
#      day or two, and nothing else would ever install it here;
#   3. the Mac's own voice (tts_fallback), which needs no network at all.

# Every host Microsoft has served the read-aloud voices from, as templates on
# the library's public client token. The installed library's own URL is tried
# too, so a host a future edge-tts moves to needs no edit here.
EDGE_ENDPOINTS = (
    "wss://speech.platform.bing.com/consumer/speech/synthesize/readaloud"
    "/edge/v1?TrustedClientToken={token}",
    "wss://api.msedgeservices.com/tts/cognitiveservices/websocket/v1"
    "?Ocp-Apim-Subscription-Key={token}",
)
LAST_ENDPOINT_FILE = os.path.join(CONFIG_DIR, "edge-endpoint")
# Per endpoint: a host that hangs must not hold up the next one.
CONNECT_TIMEOUT = 5

# A refusal upgrades edge-tts at most once an hour, so an outage costs one pip
# check an hour rather than one per read.
UPGRADE_STAMP = os.path.join(CONFIG_DIR, "edge-tts-upgrade.stamp")
UPGRADE_INTERVAL = 3600
UPGRADE_TIMEOUT = 180


class PlayerError(Exception):
    """The audio player failed: no endpoint can fix that."""


def endpoints():
    """Synthesis URLs to try, in order: the last one that worked, the
    installed library's own, then every known host."""
    import edge_tts.communicate as comm
    from edge_tts.constants import TRUSTED_CLIENT_TOKEN
    urls = []
    try:
        with open(LAST_ENDPOINT_FILE) as f:
            urls.append(f.read().strip())
    except OSError:
        pass
    urls.append(comm.WSS_URL)
    urls += [t.format(token=TRUSTED_CLIENT_TOKEN) for t in EDGE_ENDPOINTS]
    return [u for u in dict.fromkeys(urls) if u.startswith("wss://")]


def remember_endpoint(url):
    """Try this endpoint first next time: a dead one then costs one failed
    handshake, once, instead of one on every read."""
    try:
        with open(LAST_ENDPOINT_FILE) as f:
            if f.read().strip() == url:
                return
    except OSError:
        pass
    try:
        with open(LAST_ENDPOINT_FILE, "w") as f:
            f.write(url)
    except OSError:
        pass


def edge_tts_version():
    """Installed edge-tts version, read fresh from disk."""
    import importlib
    import importlib.metadata
    importlib.invalidate_caches()
    try:
        return importlib.metadata.version("edge-tts")
    except importlib.metadata.PackageNotFoundError:
        return None


def upgrade_edge_tts():
    """Install the newest edge-tts into this interpreter's environment.
    Returns True when a different version is now installed."""
    try:
        if time.time() - os.path.getmtime(UPGRADE_STAMP) < UPGRADE_INTERVAL:
            return False
    except OSError:
        pass
    os.makedirs(CONFIG_DIR, exist_ok=True)
    with open(UPGRADE_STAMP, "w"):
        pass
    before = edge_tts_version()
    try:
        # Own session, never killed: a Stop kills our process group, and pip
        # killed mid-install would leave edge-tts half-written for good.
        pip = subprocess.Popen(
            [sys.executable, "-m", "pip", "install", "--quiet",
             "--disable-pip-version-check", "--upgrade", "edge-tts"],
            stdin=subprocess.DEVNULL, stdout=subprocess.DEVNULL,
            stderr=subprocess.DEVNULL, start_new_session=True)
        pip.wait(timeout=UPGRADE_TIMEOUT)
    except (OSError, subprocess.TimeoutExpired):
        return False
    return edge_tts_version() != before


def failure_reason(exc):
    """One short, user-facing line for a failed synthesis."""
    # aiohttp's handshake error stringifies to the whole signed URL; the
    # status alone says everything worth showing.
    status = getattr(exc, "status", None)
    if status:
        return f"Microsoft's voice service refused the request (HTTP {status})."
    if isinstance(exc, ImportError):
        return "The edge-tts library is missing or broken."
    return (str(exc) or type(exc).__name__)[:160]


async def stream_tts(text, voice, rate, pitch, volume, url):
    """Stream TTS audio from one endpoint to the player.

    Returns (error, played): the exception that stopped synthesis or None,
    and whether any audio reached the player. Once it has, starting over
    elsewhere would read the beginning twice.
    """
    from contextlib import aclosing
    import edge_tts
    import edge_tts.communicate as comm
    comm.WSS_URL = url

    error = None
    player = None
    try:
        communicate = edge_tts.Communicate(
            text, voice, rate=rate, pitch=pitch, volume=volume,
            connect_timeout=CONNECT_TIMEOUT)
        # aclosing: leaving the loop early must still close the connection.
        async with aclosing(communicate.stream()) as stream:
            async for chunk in stream:
                if chunk["type"] != "audio":
                    continue
                if player is None:
                    # Started on the first audio, so an endpoint that refuses
                    # never leaves an empty player complaining on stderr.
                    try:
                        player = subprocess.Popen(
                            PLAYER_CMD, stdin=subprocess.PIPE)
                    except OSError as exc:
                        raise PlayerError(
                            f"Can't start the audio player: {exc}")
                player.stdin.write(chunk["data"])
                player.stdin.flush()
        if player is not None:
            player.stdin.close()
            if player.wait() > 0:
                raise PlayerError(
                    f"The audio player failed (exit {player.returncode}).")
    except BrokenPipeError:
        # Killed by a signal = a Stop, which takes us down with it anyway.
        if player.wait() > 0:
            error = PlayerError("The audio player quit unexpectedly.")
    except Exception as exc:
        error = exc
    finally:
        if player is not None:
            try:
                if player.stdin and not player.stdin.closed:
                    player.stdin.close()
            except Exception:
                pass
            if player.poll() is None:
                player.kill()
                player.wait()
    return error, player is not None


def speak_edge(text, voice, rate, pitch, volume):
    """Try each endpoint until one speaks.

    Returns (spoke, errors, played): errors holds every failed attempt, also
    the ones before an endpoint that worked.
    """
    import asyncio
    try:
        urls = endpoints()
    except ImportError as exc:
        return False, [exc], False
    errors = []
    rate_limited = set()
    while urls:
        url = urls.pop(0)
        error, played = asyncio.run(
            stream_tts(text, voice, rate, pitch, volume, url))
        if error is None:
            remember_endpoint(url)
            return True, errors, played
        errors.append(error)
        if played or isinstance(error, PlayerError):
            return False, errors, played
        # 429 Too Many Requests is often momentary (Microsoft throttles
        # clients it is phasing out): one more try once the others are done.
        if getattr(error, "status", None) == 429 and url not in rate_limited:
            rate_limited.add(url)
            urls.append(url)
    return False, errors, False


def worth_upgrading(errors):
    """An HTTP refusal is how a Microsoft protocol change shows up, and a
    missing library is reinstalled by the same pip run."""
    return any(getattr(e, "status", None) or isinstance(e, ImportError)
               for e in errors)


def voice_locale(voice):
    """"fr-FR-HenriNeural" -> "fr-FR"."""
    return "-".join(voice.split("-")[:2])


def main():
    """Exit status: 1 when nothing could read the text (reason on stderr),
    else 0."""
    args = parse_args()

    if args["stop"]:
        stop_existing()
        return

    # Stop any existing speech first
    stop_existing()

    # New process group so one signal kills us + play child. Must happen
    # BEFORE reading stdin: a process wedged in stdin.read() with no PID
    # file registered is unstoppable from the outside.
    try:
        os.setpgrp()
    except OSError:
        pass  # already a group/session leader (spawned with start_new_session)

    # Write PID file
    os.makedirs(CONFIG_DIR, exist_ok=True)
    with open(PID_FILE, "w") as f:
        f.write(str(os.getpgid(0)))

    try:
        if args["stdin"]:
            args["text"] = sys.stdin.read()
        if not args["text"]:
            return

        # Load settings, CLI args take priority
        settings = load_settings()
        voice = auto_voice(args["text"], settings, args["voice"])
        rate = args["rate"] or settings["rate"]
        pitch = args["pitch"] or settings["pitch"]
        volume = args["volume"] or settings.get("volume", "+0%")

        text = clean_text_for_speech(args["text"])
        if not text:
            return

        try:
            spoke, errors, played = speak_edge(
                text, voice, rate, pitch, volume)
        except (KeyboardInterrupt, SystemExit):
            return
        if spoke:
            # A refusal on the way there means this edge-tts is falling
            # behind Microsoft: update it now, while nobody waits on it.
            if worth_upgrading(errors):
                upgrade_edge_tts()
            return
        if (tts_fallback is not None and not played
                and worth_upgrading(errors) and upgrade_edge_tts()):
            # A fresh process, so the upgraded edge-tts is the one imported.
            tts_fallback.exec_with_stdin(
                [sys.executable, os.path.abspath(__file__), "--stdin",
                 "--voice", voice, "--rate", rate, "--pitch", pitch,
                 "--volume", volume],
                args["text"])
        reason = failure_reason(errors[-1])
        # Scribe and speak-selection.sh show this line to the user when
        # nothing else speaks either, so a dead service is never silent.
        print(f"[edge-tts] {reason}", file=sys.stderr)
        if played and not isinstance(errors[-1], PlayerError):
            return 1  # cut off mid-read: another voice would start it over
        if tts_fallback is None:
            return 1
        tts_fallback.notify("Read aloud: using the Mac's voice",
                            f"Microsoft Edge failed: {reason}")
        if tts_fallback.speak_with_system_voice(text, voice_locale(voice)):
            return 0
        print(f"[edge-tts] {reason} The Mac's own voice failed too.",
              file=sys.stderr)
        return 1
    finally:
        # Only remove the PID file if it still points at us — a newer
        # speak process may have replaced it, and deleting that entry
        # would make the new playback unstoppable.
        try:
            with open(PID_FILE) as f:
                if int(f.read().strip()) == os.getpgid(0):
                    os.unlink(PID_FILE)
        except (OSError, ValueError):
            pass


if __name__ == "__main__":
    sys.exit(main())
